{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kernel-oops/opencode-background-tasks",
  "version": "2.0.30",
  "private": true,
  "description": "Background task presentation for compatible OpenCode V2 fork hosts",
  "license": "MIT",
  "engines": { "bun": ">=1.4.2" },
  "type": "module",
  "exports": {
    "./tui": "./tui.js",
    "./session": "./src/session.ts"
  },
  "files": ["dist", "tui.js", "src/session.ts", "README.md"],
  "scripts": {
    "build": "bun run build.ts",
    "types": "tsc -p tsconfig.session.json",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test --timeout 30000 --only-failures"
  },
  "peerDependencies": {
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@opencode/client": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
