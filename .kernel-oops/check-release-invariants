#!/usr/bin/env bash
# Fork release gate. Default: fail unless every test in .kernel-oops/release-invariants exists and passes.
# --overlap OLD NEW [OURS]: list upstream OLD..NEW commits touching files our OLD..OURS patch set also changes.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
list="$root/.kernel-oops/release-invariants"

if [ "${1:-}" = "--overlap" ]; then
  old=${2:?OLD tag}; new=${3:?NEW tag}; ours=${4:-HEAD}
  comm -12 <(git -C "$root" diff --name-only "$old" "$ours" | sort) <(git -C "$root" diff --name-only "$old" "$new" | sort) |
    while read -r file; do
      echo "== $file"
      git -C "$root" log --oneline --no-merges "$old..$new" -- "$file"
    done
  exit 0
fi

entries=()
missing=0
while read -r dir file _; do
  [[ -z "$dir" || "$dir" == \#* ]] && continue
  if [ -f "$root/$dir/$file" ]; then entries+=("$dir $file"); else echo "MISSING invariant test: $dir/$file" >&2; missing=1; fi
done <"$list"
[ "$missing" -eq 0 ] || exit 1
[ "${#entries[@]}" -gt 0 ] || { echo "no invariant tests listed in $list" >&2; exit 1; }

failed=0
for entry in "${entries[@]}"; do
  read -r dir file <<<"$entry"
  echo "== $dir/$file"
  (cd "$root/$dir" && bun test "$file") || { echo "FAILED invariant test: $dir/$file" >&2; failed=1; }
done
exit "$failed"
